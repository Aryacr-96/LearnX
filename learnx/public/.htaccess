
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Do not rewrite existing files or folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send React routes to index.html
    RewriteRule ^ index.html [L]
</IfModule>
